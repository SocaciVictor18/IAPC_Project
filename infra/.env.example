# Copy to infra/.env and fill in. infra/.env is git-ignored – never commit secrets.

# ---- LLM provider: openai (default) or ollama (fully local, start compose with --profile local-llm)
CHAT_PROVIDER=openai
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o
UTILITY_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# text-embedding-3-small = 1536, nomic-embed-text (Ollama) = 768. Changing it requires a fresh database (re-index).
EMBEDDING_DIMS=1536

# For Ollama (100% local, start compose with --profile local-llm) use instead:
# CHAT_PROVIDER=ollama
# EMBEDDING_PROVIDER=ollama
# UTILITY_MODEL=llama3.2
# EMBEDDING_DIMS=768
OLLAMA_URL=http://ollama:11434

# For Claude (Anthropic) as chat model use instead – Anthropic has no embeddings API, so embeddings
# stay local on Ollama (start compose with --profile local-llm):
# CHAT_PROVIDER=anthropic
# EMBEDDING_PROVIDER=ollama
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_CHAT_MODEL=claude-opus-5-5
# UTILITY_MODEL=claude-haiku-5-5
# EMBEDDING_DIMS=768
ANTHROPIC_API_KEY=

# ---- Reranker: tei (local cross-encoder container) | cohere | llm | none
RERANK_PROVIDER=tei
COHERE_API_KEY=

# ---- Secrets (generate your own!)
# AES-256 key, 32 random bytes base64:  openssl rand -base64 32
DATA_ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_base64_32
# Client secret of the compliance-service machine client (service-to-service JWT)
SERVICE_CLIENT_SECRET=change-me-service-secret
# Password of all seeded demo users
SEED_DEFAULT_PASSWORD=EduPulse#2026

# ---- Database
POSTGRES_PASSWORD=postgres_admin_pw
AUTH_DB_PASSWORD=auth_app_pw
INGESTION_DB_PASSWORD=ingestion_app_pw
COMPLIANCE_DB_PASSWORD=compliance_app_pw

# ---- Grafana admin
GRAFANA_ADMIN_PASSWORD=admin

# ---- Public port of nginx (80 by default)
HTTP_PORT=80
