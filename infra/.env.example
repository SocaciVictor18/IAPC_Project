# Copy to infra/.env (git-ignored – never commit secrets).

# ---- Required: AES-256 key for encrypting files, parent chunks and personal data.
# Generate one with:  openssl rand -base64 32
DATA_ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_base64_32

# ---- LLM provider. Default: Ollama, 100% local and free (models: llama3.2 + nomic-embed-text).
CHAT_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
UTILITY_MODEL=llama3.2
EMBEDDING_DIMS=768

# ---- Option 2: Claude (Anthropic) answers, embeddings stay on Ollama (Anthropic has no embedding API).
# CHAT_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_CHAT_MODEL=claude-opus-5-5
# UTILITY_MODEL=claude-haiku-5-5

# ---- Option 3: OpenAI for everything (needs a fresh database: 1536-dim embeddings).
# CHAT_PROVIDER=openai
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# UTILITY_MODEL=gpt-4o-mini
# EMBEDDING_DIMS=1536

# ---- Demo users password and database passwords
SEED_DEFAULT_PASSWORD=EduPulse#2026
POSTGRES_PASSWORD=postgres_admin_pw
AUTH_DB_PASSWORD=auth_app_pw
INGESTION_DB_PASSWORD=ingestion_app_pw
COMPLIANCE_DB_PASSWORD=compliance_app_pw

# ---- Public port of the app (use 8088 if port 80 is already taken)
HTTP_PORT=80
