# Copy to infra/.env (git-ignored – never commit secrets).

# ---- Required: AES-256 key for encrypting files, parent chunks and personal data.
# Generate one with:  openssl rand -base64 32
DATA_ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_base64_32


# ---- Demo users password and database passwords
SEED_DEFAULT_PASSWORD=EduPulse#2026
POSTGRES_PASSWORD=postgres_admin_pw
AUTH_DB_PASSWORD=auth_app_pw
INGESTION_DB_PASSWORD=ingestion_app_pw
COMPLIANCE_DB_PASSWORD=compliance_app_pw

# ---- Public port of the app (use 8088 if port 80 is already taken)
HTTP_PORT=80
